# 网站只读数据库连接串（只读角色 gaokao_web_ro，禁止写入）
GAOKAO_DSN=postgresql://gaokao_web_ro:CHANGE_ME@localhost:5432/gaokao

# production 会强制校验 CORS 和 JWT；本地开发保持 development
APP_ENV=development

# 允许的前端源（逗号分隔）；本地开发可留 *
CORS_ORIGINS=*

# 单接口最大返回行数
MAX_PAGE_SIZE=500

# ---- 用户认证 ----
# 用户 SQLite 库路径（默认 backend/data/users.db）
USER_DB_PATH=data/users.db
# JWT 签名密钥：生产必须改为强随机值，例如 `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET
# 登录有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168

# ---- AI 参谋（默认关闭；邀请名单支持用户 ID、邮箱或用户名） ----
AGENT_ENABLED=false
AGENT_ALLOWLIST=
AGENT_DB_PATH=data/agent.db
AGENT_MAX_CONCURRENCY=4
AGENT_USER_HOURLY_LIMIT=30
AGENT_JOB_TIMEOUT_SECONDS=60
AGENT_DAILY_TOKEN_BUDGET=200000
AGENT_JOB_RETENTION_HOURS=24
AGENT_TRACE_RETENTION_DAYS=30
LLM_PROVIDER=ericai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=se-gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET_FILE=/run/secrets/azure-client-secret
