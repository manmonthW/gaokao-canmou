# 网站只读数据库连接串（只读角色 gaokao_web_ro，禁止写入）
# Vercel + Neon：用带 -pooler 的连接串，并加 ?sslmode=require
GAOKAO_DSN=postgresql://gaokao_web_ro:CHANGE_ME@localhost:5432/gaokao
# 只读库连接池上限：常驻容器默认 12；Serverless 建议 2–3
GAOKAO_DB_POOL_MAX=12

# 可写库（用户 + Agent 任务）。留空则用下面的 SQLite 文件；设置后改用 PostgreSQL。
# 必须是独立的读写角色（如 gaokao_app_rw），不要复用 gaokao_web_ro 或库 owner。
APP_DB_URL=
APP_DB_POOL_MAX=3
# 连接池用满时最多排队等待的秒数
DB_POOL_WAIT_SECONDS=10

# 静态材料（院校图/PDF/分布图）。留空 = 读本地 2026allmaterial/；
# 设置为 scripts/blob/upload.mjs 生成的清单路径（相对 backend/）后，端点改为 302 跳转到 Vercel Blob。
ASSET_MANIFEST=

# production 会强制校验 CORS 和 JWT；本地开发保持 development
APP_ENV=development

# 允许的前端源（逗号分隔）；本地开发可留 *
CORS_ORIGINS=*

# 单接口最大返回行数
MAX_PAGE_SIZE=500

# ---- 用户认证 ----
# 用户 SQLite 库路径（默认 backend/data/users.db）
USER_DB_PATH=data/users.db
# JWT 签名密钥：生产必须改为强随机值，例如 `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET
# 登录有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168

# ---- AI 参谋（默认关闭；邀请名单支持用户 ID、邮箱或用户名） ----
AGENT_ENABLED=false
AGENT_ALLOWLIST=
AGENT_DB_PATH=data/agent.db
AGENT_MAX_CONCURRENCY=4
AGENT_USER_HOURLY_LIMIT=30
AGENT_JOB_TIMEOUT_SECONDS=60
AGENT_DAILY_TOKEN_BUDGET=200000
AGENT_JOB_RETENTION_HOURS=24
AGENT_TRACE_RETENTION_DAYS=30
# ericai | deepseek
LLM_PROVIDER=ericai
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 二选一：DEEPSEEK_API_KEY（Vercel 等只能注入 env 的平台）或 DEEPSEEK_API_KEY_FILE（容器挂载）
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=se-gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET_FILE=/run/secrets/azure-client-secret
